NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Create the database yourself or explicitly start Compose postgres before running migrations.
# This URL targets the optional local Docker PostgreSQL. Adjust for your own PostgreSQL.
DATABASE_URL=postgresql://auth:auth_local_only@localhost:5433/auth_db
# Auth owns the private key. Gateway receives only its matching public key.
JWT_PRIVATE_KEY_PATH=./keys/auth-private.pem

JWT_ISSUER=restaurant-auth
JWT_AUDIENCE=restaurant-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=refresh_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
# Optional Gateway integration: existing local image or published registry tag, no source needed.
GATEWAY_IMAGE=tablebooking-gateway:auth-integration
GATEWAY_URL=http://localhost:8081
